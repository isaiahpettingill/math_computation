       "3 + 2 y\n",
       "\\end{equation}\n",
       " $$"
      ],
      "text/plain": [
       "3 + 2y"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "expand_derivatives(g_prime)"
   ]
  }
